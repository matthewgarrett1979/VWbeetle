CLOUDINARY_CLOUD=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# TOTP secret for admin authentication (generate via /api/setup)
TOTP_SECRET=your_totp_secret

# Upstash Redis — checklist state, blog posts, auth sessions and rate limiting.
# Until these are set, api/_upstash.js falls back to hardcoded values so the
# site keeps working. Set them in Vercel, then remove the fallbacks.
UPSTASH_URL=https://your-instance.upstash.io
UPSTASH_TOKEN=your_upstash_rest_token
